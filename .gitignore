# =============================================================================
# Nexus VPN — .gitignore
# PUBLIC REPOSITORY != PUBLIC SECRETS
# Anything that could carry a secret, a credential or real user data stays out.
# =============================================================================

# --- Secrets & environment -------------------------------------------------
.env
.env.*
!.env.example
*.env
!example.env
secrets/
secrets.*
*.secret
*.secrets
credentials.json
service-account*.json
firebase-adminsdk*.json
fcm-*.json
google-services.json
.envrc

# --- Keys & certificates ---------------------------------------------------
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.crt
*.cer
*.der
*.asc
*.gpg
*.ppk
id_rsa*
id_ed25519*
known_hosts
authorized_keys
keystore.properties
signing.properties

# --- Databases & backups ---------------------------------------------------
*.db
*.db-journal
*.sqlite
*.sqlite3
*.sql
*.dump
*.bak
*.backup
backups/
dumps/
pgdata/
postgres-data/
redis-data/

# --- Logs ------------------------------------------------------------------
*.log
logs/
npm-debug.log*
yarn-error.log*

# --- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib60/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.venv/
venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/
.hypothesis/

# --- Node / Next.js (admin) ------------------------------------------------
node_modules/
.next/
out/
.turbo/
.pnpm-store/
*.tsbuildinfo
.npmrc
.yarnrc.yml

# --- Android ---------------------------------------------------------------
android/.gradle/
android/local.properties
android/build/
android/app/build/
android/captures/
android/.idea/
android/app/release/
android/app/debug/
*.apk
*.aab
*.aar
.cxx/

# --- IDE / OS --------------------------------------------------------------
.idea/
.vscode/
*.iml
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# --- Docker / runtime ------------------------------------------------------
docker-compose.override.yml
.docker/
*.pid

# --- Misc ------------------------------------------------------------------
tmp/
temp/
.cache/
*.tar.gz
*.zip
!scripts/**/*.zip

# The nginx config is rendered from nginx.conf.template by scripts/deploy.sh
# with the real domain substituted in. The template is tracked; the rendered
# file is per-deployment and stays out of git.
infrastructure/nginx/nginx.conf
infrastructure/nginx/certs/
