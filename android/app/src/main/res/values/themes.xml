<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose owns the real theming; this is the launch theme, sized to
         avoid a white flash before the first frame. -->
    <style name="Theme.Nexora" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/launch_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
