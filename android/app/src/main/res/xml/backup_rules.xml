<?xml version="1.0" encoding="utf-8"?>
<!-- Backup is disabled in the manifest. This file exists so the intent is
     explicit: tokens and cached account data must never leave the device in a
     cloud backup. -->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
</full-backup-content>
