# =============================================================================
# Nexus VPN reverse proxy (spec rule 40).
#
# This is a TEMPLATE. scripts/deploy.sh renders it to nginx.conf with
# ${NEXUS_DOMAIN} substituted; the rendered file is git-ignored, so no
# deployment's domain is ever committed.
#
# Certificates come from the certbot volume and are never in the repository or
# the image.
# =============================================================================
user nginx;
worker_processes auto;
error_log /var/log/nginx/error.log warn;
pid /var/run/nginx.pid;

events {
    worker_connections 2048;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/json;
    server_tokens off;          # do not advertise the nginx version

    # The access log omits the Authorization header and request bodies.
    log_format json escape=json
      '{"time":"$time_iso8601","ip":"$remote_addr","method":"$request_method",'
      '"path":"$uri","status":$status,"bytes":$body_bytes_sent,'
      '"rt":$request_time,"request_id":"$http_x_request_id"}';
    access_log /var/log/nginx/access.log json;

    sendfile on;
    keepalive_timeout 65;
    client_max_body_size 10m;
    client_body_timeout 15s;

    gzip on;
    gzip_types application/json text/plain;

    # Rate limiting at the edge, in front of the application's own limiter.
    limit_req_zone $binary_remote_addr zone=api:10m rate=30r/s;
    limit_req_zone $binary_remote_addr zone=auth:10m rate=5r/m;
    limit_conn_zone $binary_remote_addr zone=conn:10m;

    upstream nexus_api {
        server api:8000;
        keepalive 32;
    }

    # --- HTTP: redirect everything except the ACME challenge ----------------
    server {
        listen 80;
        server_name ${NEXUS_DOMAIN};

        location /.well-known/acme-challenge/ {
            root /var/www/certbot;
        }
        location / {
            return 301 https://$host$request_uri;
        }
    }

    # --- HTTPS API ----------------------------------------------------------
    server {
        listen 443 ssl;
        http2 on;
        server_name ${NEXUS_DOMAIN};

        ssl_certificate     /etc/letsencrypt/live/${NEXUS_DOMAIN}/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/${NEXUS_DOMAIN}/privkey.pem;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_prefer_server_ciphers off;
        ssl_session_cache shared:SSL:10m;
        ssl_session_timeout 1d;
        ssl_session_tickets off;

        add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "no-referrer" always;

        limit_conn conn 20;

        # Authentication endpoints get a much tighter limit: this is the
        # surface a credential-stuffing run would target.
        location ~ ^/api/v1/auth/(login|register|refresh|forgot-password) {
            limit_req zone=auth burst=5 nodelay;
            proxy_pass http://nexus_api;
            include /etc/nginx/proxy_params_nexus;
        }

        location / {
            limit_req zone=api burst=60 nodelay;
            proxy_pass http://nexus_api;
            include /etc/nginx/proxy_params_nexus;
        }

        # Health checks stay internal.
        location /health {
            allow 127.0.0.1;
            allow 10.0.0.0/8;
            allow 172.16.0.0/12;
            deny all;
            proxy_pass http://nexus_api;
            include /etc/nginx/proxy_params_nexus;
        }
    }
}
