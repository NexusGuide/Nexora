+### Fixed — the first Android build
+
+The first CI build failed in `:app:processDebugResources`, before a line of
+Kotlin was compiled: the manifest referenced `@mipmap/ic_launcher` and
+`@mipmap/ic_launcher_round`, and the app had no `mipmap` directory at all.
+Phase 4 shipped a manifest whose icons were never drawn.
+
+- **Launcher icons**, in the app's own palette (teal shield, navy `N`) rather
+  than a placeholder: an adaptive icon for API 26+, a `<monochrome>` layer for
+  themed icons on API 33+, and real PNGs at five densities because `minSdk` is
+  24 and API 24–25 do not understand adaptive icons. The PNGs are rendered
+  from the same coordinates as the vector, so the two cannot drift apart.
+- **The launch background was wrong in both themes.** `values/` and
+  `values-night/` both held the same navy, so a light-theme launch flashed
+  dark before Compose painted `#F8FAFC`. Each now matches its scheme's
+  `background` in `core/ui/Theme.kt`.
+- **Deleted `values-night/themes.xml`**, which redefined `Theme.Nexora`
+  *without* `windowBackground` — so in dark mode the launch theme fell back to
+  the Material light background, producing exactly the white flash the theme
+  exists to prevent.
+- Audited every `@string`/`@color`/`@drawable`/`@mipmap`/`@xml` reference in
+  the manifest, resources and Kotlin against what is defined. Nothing else is
+  missing, so the next build should reach the compiler.
+
 ### Fixed — the executable bit, and how it went missing
 
 - **`.githooks/pre-commit` and all three `scripts/*.sh` had been rewritten to
diff --git a/android/app/src/main/res/drawable/ic_launcher_background.xml b/android/app/src/main/res/drawable/ic_launcher_background.xml
new file mode 100644
index 0000000..3eddab3
--- /dev/null
+++ b/android/app/src/main/res/drawable/ic_launcher_background.xml
@@ -0,0 +1,24 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!--
+  Adaptive-icon background: the app's dark navy, with one faint diagonal
+  band so the icon does not read as a flat rectangle when a launcher
+  parallaxes the layers apart.
+
+  This layer is deliberately full-bleed. The launcher crops it to its own
+  shape, so it must cover the whole 108dp canvas with no detail near the
+  edges that would matter if cropped.
+-->
+<vector xmlns:android="http://schemas.android.com/apk/res/android"
+    android:width="108dp"
+    android:height="108dp"
+    android:viewportWidth="108"
+    android:viewportHeight="108">
+
+    <path
+        android:fillColor="#FF0B1E2D"
+        android:pathData="M0,0 L108,0 L108,108 L0,108 Z" />
+
+    <path
+        android:fillColor="#FF13293D"
+        android:pathData="M0,108 L108,0 L108,34 L34,108 Z" />
+</vector>
diff --git a/android/app/src/main/res/drawable/ic_launcher_foreground.xml b/android/app/src/main/res/drawable/ic_launcher_foreground.xml
new file mode 100644
index 0000000..8995a8c
--- /dev/null
+++ b/android/app/src/main/res/drawable/ic_launcher_foreground.xml
@@ -0,0 +1,34 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!--
+  The launcher mark: a shield carrying an "N".
+
+  Drawn on the 108dp adaptive-icon canvas. Every launcher masks this to its
+  own shape and may parallax it, so the artwork stays inside the central
+  66dp safe zone (x and y between 21 and 87) — anything outside it can be
+  cropped away on some devices.
+-->
+<vector xmlns:android="http://schemas.android.com/apk/res/android"
+    xmlns:aapt="http://schemas.android.com/aapt"
+    android:width="108dp"
+    android:height="108dp"
+    android:viewportWidth="108"
+    android:viewportHeight="108">
+
+    <!-- Shield. Teal, matching the app's primary colour. -->
+    <path android:pathData="M54,25 L79,33.5 L79,56 C79,69.5 67.5,78.5 54,83.5 C40.5,78.5 29,69.5 29,56 L29,33.5 Z">
+        <aapt:attr name="android:fillColor">
+            <gradient
+                android:startX="29" android:startY="25"
+                android:endX="79" android:endY="83.5"
+                android:type="linear">
+                <item android:offset="0" android:color="#FF5DF2D6" />
+                <item android:offset="1" android:color="#FF00897B" />
+            </gradient>
+        </aapt:attr>
+    </path>
+
+    <!-- The N, cut out of the shield in the app's dark navy. -->
+    <path
+        android:fillColor="#FF0B1E2D"
+        android:pathData="M41,42 L48,42 L60,61 L60,42 L67,42 L67,70 L60,70 L48,51 L48,70 L41,70 Z" />
+</vector>
diff --git a/android/app/src/main/res/drawable/ic_launcher_monochrome.xml b/android/app/src/main/res/drawable/ic_launcher_monochrome.xml
new file mode 100644
index 0000000..ccad1e7
--- /dev/null
+++ b/android/app/src/main/res/drawable/ic_launcher_monochrome.xml
@@ -0,0 +1,18 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!--
+  The themed-icon layer (API 33+). The system tints this single shape to the
+  user's wallpaper colours, so it must be one flat colour with no gradient:
+  the "N" is knocked out of the shield with evenOdd winding rather than
+  painted over it, which is what makes the letter survive tinting.
+-->
+<vector xmlns:android="http://schemas.android.com/apk/res/android"
+    android:width="108dp"
+    android:height="108dp"
+    android:viewportWidth="108"
+    android:viewportHeight="108">
+
+    <path
+        android:fillColor="#FFFFFFFF"
+        android:fillType="evenOdd"
+        android:pathData="M54,25 L79,33.5 L79,56 C79,69.5 67.5,78.5 54,83.5 C40.5,78.5 29,69.5 29,56 L29,33.5 Z M41,42 L48,42 L60,61 L60,42 L67,42 L67,70 L60,70 L48,51 L48,70 L41,70 Z" />
+</vector>
diff --git a/android/app/src/main/res/mipmap-anydpi-v26/ic_launcher.xml b/android/app/src/main/res/mipmap-anydpi-v26/ic_launcher.xml
new file mode 100644
index 0000000..7331115
--- /dev/null
+++ b/android/app/src/main/res/mipmap-anydpi-v26/ic_launcher.xml
@@ -0,0 +1,10 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!--
+  Adaptive icon, used from API 26. Earlier versions (this app supports from
+  API 24) fall back to the PNGs in the density-specific mipmap folders.
+-->
+<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
+    <background android:drawable="@drawable/ic_launcher_background" />
+    <foreground android:drawable="@drawable/ic_launcher_foreground" />
+    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
+</adaptive-icon>
