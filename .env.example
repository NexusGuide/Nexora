# =============================================================================
# Nexus VPN — Environment template
# =============================================================================
# Copy to `.env` and fill in REAL values on the deployment machine ONLY.
#
#   cp .env.example .env
#   ./scripts/generate-secrets.sh          # prints fresh random secrets
#
# `.env` is git-ignored. NEVER commit real values. Every placeholder below is
# intentionally a description in angle brackets, not a working credential —
# the backend refuses to start if a placeholder is left in place (see
# backend/app/core/config.py).
# =============================================================================

# --- Application -----------------------------------------------------------
APP_ENV=development                 # development | staging | production
APP_NAME=NexusVPN
APP_DEBUG=true                      # MUST be false in production
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR

# Comma-separated origins allowed to call the API (admin panel, web front-end).
# Do NOT use "*" in production.
CORS_ORIGINS=http://localhost:3000

# Hosts the API will answer for. Do NOT use "*" in production.
ALLOWED_HOSTS=localhost,127.0.0.1

# Public base URL of the API — used to build payment callback URLs.
PUBLIC_API_URL=http://localhost:8000

# --- Database --------------------------------------------------------------
# Async driver is required (postgresql+asyncpg://).
DATABASE_URL=postgresql+asyncpg://nexus:<db-password>@postgres:5432/nexusvpn

# Used by docker-compose to initialise the postgres container.
POSTGRES_USER=nexus
POSTGRES_PASSWORD=<db-password>
POSTGRES_DB=nexusvpn

# --- Redis -----------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- Security / tokens -----------------------------------------------------
# Generate each of these independently:  openssl rand -hex 32
# They must differ from each other and must be at least 32 characters.
JWT_SECRET=<generate-with-openssl-rand-hex-32>
JWT_REFRESH_SECRET=<generate-with-openssl-rand-hex-32>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Fernet-compatible 32-byte urlsafe-base64 key used to encrypt panel
# credentials at rest. Generate with:
#   python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# ROTATING THIS KEY MAKES EXISTING ENCRYPTED PANEL CREDENTIALS UNREADABLE.
# Back it up separately from the database (see docs/security.md).
ENCRYPTION_KEY=<generate-32-byte-urlsafe-base64-key>

# Bootstrap secret for creating the first owner account. Rotate after use.
ADMIN_BOOTSTRAP_SECRET=<generate-with-openssl-rand-hex-32>

# --- Rate limiting / brute force -------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# --- Payments --------------------------------------------------------------
# Active provider: zibal | zarinpal | idpay | card_to_card | manual
PAYMENT_PROVIDER=manual
PAYMENT_API_KEY=<payment-gateway-api-key>
PAYMENT_CALLBACK_URL=http://localhost:8000/api/v1/payments/callback

# --- Panels ----------------------------------------------------------------
# Panel credentials are normally entered through the admin panel and stored
# ENCRYPTED in the database — not here. These variables exist only for the
# optional bootstrap of a first panel in a fresh install.
PASARGUARD_URL=
PASARGUARD_USERNAME=
PASARGUARD_PASSWORD=

# --- Email -----------------------------------------------------------------
# Leave SMTP_HOST empty in development: the app then uses a console transport
# that LOGS the password-reset link instead of sending it. Nothing is
# delivered, which is what you want locally and never what you want in
# production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=<smtp-password>
SMTP_FROM=noreply@example.com
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Where the reset link sends the user. This is your front-end or app deep
# link, not necessarily the API host.
PASSWORD_RESET_URL=https://example.com/reset-password
RESET_TOKEN_TTL_MINUTES=60
VERIFY_TOKEN_TTL_HOURS=24

# --- Backups ---------------------------------------------------------------
# Optional. When set, scripts/backup-db.sh encrypts each dump to this GPG
# recipient. Keep the private key somewhere other than this server.
BACKUP_GPG_RECIPIENT=
BACKUP_DIR=
RETAIN_DAILY=7
RETAIN_WEEKLY=4
RETAIN_MONTHLY=12

# --- Notifications ---------------------------------------------------------
FCM_PROJECT_ID=
# Path to the service-account JSON on the server. NEVER inline the key here
# and never commit the file (it is git-ignored).
FCM_CREDENTIALS_FILE=

# --- Monitoring ------------------------------------------------------------
SENTRY_DSN=
METRICS_ENABLED=false
